<launch>


    <!-- Camera TF -->
    <include file="$(find go1_local_approach)/launch/camera_tf.launch"/>


    <!-- Fake vision -->
    <node
        pkg="go1_local_approach"
        type="fake_vision"
        name="fake_vision"
        output="screen"/>


    <!-- Vision coordinate transform -->
    <node
        pkg="go1_local_approach"
        type="vision_to_goal"
        name="vision_to_goal"
        output="screen"/>

    <node
    pkg="go1_local_approach"
    type="yaw_error_test"
    name="yaw_error_test"
    output="screen"/>


    <!-- RViz -->
    <node
        pkg="rviz"
        type="rviz"
        name="rviz"/>

    <node
	pkg="go1_local_approach"
	type="task_manager"
	name="task_manager"
	output="screen"/>
    
    <node
        pkg="go1_local_approach"
        type="approach_controller"
        name="approach_controller"
        output="screen"/>

</launch>
