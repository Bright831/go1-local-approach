<launch>

    <!--
        DEVELOPMENT / SELF-TEST

        Uses fake_button_vision instead of real YOLO.
    -->


    <!-- Fake external vision -->
    <node
        pkg="go1_local_approach"
        type="fake_button_vision"
        name="fake_button_vision"
        output="screen"
    />


    <!-- Go1 front depth processing -->
    <node
        pkg="go1_local_approach"
        type="depth_distance_node"
        name="depth_distance_node"
        output="screen"
    />


    <!-- Local controller -->
    <node
        pkg="go1_local_approach"
        type="button_approach_controller"
        name="button_approach_controller"
        output="screen">

        <rosparam
            command="load"
            file="$(find go1_local_approach)/config/button_controller.yaml"
        />

    </node>

</launch>
